{
  "name": "colaboradocs",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "test": "npm --workspaces --if-present run test",
    "build": "npm --workspace=@colaboradocs/web run build",
    "dev": "npm --workspace=@colaboradocs/review-worker run dev & npm --workspace=@colaboradocs/web run dev & wait",
    "dev:api": "npm --workspace=@colaboradocs/review-worker run dev",
    "dev:web": "npm --workspace=@colaboradocs/web run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "typescript": "^5.6.3"
  }
}
