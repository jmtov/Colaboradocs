{
  "rules": {
    "declaration-property-value-disallowed-list": [
      {
        "/(transition|transition-duration|transition-delay|transition-timing-function|animation|animation-duration|animation-delay|animation-timing-function|--[\\w-]*(duration|ease)[\\w-]*)/": [
          "/(?<![\\d.])(?!0m?s\\b)\\d*\\.?\\d+m?s\\b/",
          "/(?<![\\w-])(ease|ease-in|ease-out|ease-in-out|linear)(?![\\w-])/",
          "/cubic-bezier\\(/",
          "/steps\\(/"
        ]
      },
      {
        "message": "Valor quemado: la duración y la curva de una transición salen de variables (--duration-*, --ease*); ver apps/web/src/index.css. Un valor fuera de ellas se justifica con un comentario stylelint-disable-next-line."
      }
    ],
    "declaration-property-value-allowed-list": [
      {
        "/^(border|border-(top|bottom)-(left|right)|border-(start|end)-(start|end))-radius$/": [
          "/^(0|inherit|var\\(.+\\))$/"
        ],
        "font-family": ["/^(var\\(.+\\)|inherit)$/"],
        "font-size": ["/^(var\\(.+\\)|calc\\(.*var\\(.+\\).*\\)|inherit)$/"],
        "font-weight": ["/^(var\\(.+\\)|inherit)$/"],
        "font": [
          "/^(?!(\\d{3}|bold|bolder|lighter)\\s)(?!.*[\\s/][\\d.]+(px|rem|em|pt)\\b)(?!.*[\"']).*$/"
        ],
        "/^(border(-(top|right|bottom|left|block|inline)(-(start|end))?)?(-width)?|outline(-width)?)$/": [
          "/^(?!.*(^|[\\s(])-?[\\d.]+(px|rem|em)\\b).*$/"
        ]
      },
      {
        "message": "Tipografía, bordes y radios salen de variables: --font-*, --font-size-*, --font-weight-*, --border-w*, --radius-* (apps/web/src/index.css); font-family, font-size y font-weight no admiten valores sueltos, ni los bordes un ancho en px. Un caso fuera de eso se justifica con un comentario stylelint-disable-next-line."
      }
    ],
    "color-no-hex": [
      true,
      {
        "message": "Un color no se escribe en un componente: usa una variable (--fg, --bg, --line, --danger…); un color nuevo se define en apps/web/src/index.css."
      }
    ],
    "color-named": [
      "never",
      {
        "message": "Un color no se escribe en un componente: usa una variable (ver apps/web/src/index.css)."
      }
    ],
    "function-disallowed-list": [
      ["rgb", "rgba", "hsl", "hsla", "hwb", "lab", "lch", "oklab", "oklch"],
      {
        "message": "Un color no se escribe en un componente: usa una variable (ver apps/web/src/index.css). color-mix() con variables sí vale."
      }
    ],
    "declaration-property-unit-disallowed-list": [
      {
        "/^(padding|margin|gap|row-gap|column-gap)(-.+)?$/": ["rem"]
      },
      {
        "message": "El espaciado sale de la escala: var(--space-1…7) (apps/web/src/index.css). Un valor fuera de ella se justifica con un comentario stylelint-disable-next-line."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "apps/web/src/AdminPage/**/*.module.css",
        "apps/web/src/ChoiceGroup/**/*.module.css",
        "apps/web/src/DocumentPage/**/*.module.css",
        "apps/web/src/DocumentSheet/**/*.module.css",
        "apps/web/src/DocumentsPage/**/*.module.css",
        "apps/web/src/Editor/**/*.module.css",
        "apps/web/src/EditorPage/**/*.module.css",
        "apps/web/src/FieldGroup/**/*.module.css",
        "apps/web/src/FilePicker/**/*.module.css",
        "apps/web/src/Hero/**/*.module.css",
        "apps/web/src/HowToReview/**/*.module.css",
        "apps/web/src/Loading/**/*.module.css",
        "apps/web/src/NewDeckSheet/**/*.module.css",
        "apps/web/src/PageBar/**/*.module.css",
        "apps/web/src/PeopleCards/**/*.module.css",
        "apps/web/src/Prose/**/*.module.css",
        "apps/web/src/ReviewNavigation/**/*.module.css",
        "apps/web/src/ReviewSummary/**/*.module.css",
        "apps/web/src/SectionView/**/*.module.css",
        "apps/web/src/SideNav/**/*.module.css",
        "apps/web/src/Skeleton/**/*.module.css",
        "apps/web/src/SourcesFooter/**/*.module.css",
        "apps/web/src/ThemeSwitch/**/*.module.css",
        "apps/web/src/TopBar/**/*.module.css",
        "apps/web/src/UserMenu/**/*.module.css",
        "apps/web/src/VersionsSheet/**/*.module.css",
        "packages/review-ui/src/AccessPanel/**/*.module.css",
        "packages/review-ui/src/ActionMenu/**/*.module.css",
        "packages/review-ui/src/ApprovalsSheet/**/*.module.css",
        "packages/review-ui/src/BlockLayer/**/*.module.css",
        "packages/review-ui/src/BottomSheet/**/*.module.css",
        "packages/review-ui/src/Button/**/*.module.css",
        "packages/review-ui/src/MenuConfirm/**/*.module.css",
        "packages/review-ui/src/MenuItem/**/*.module.css",
        "packages/review-ui/src/PersonCard/**/*.module.css",
        "packages/review-ui/src/PinGate/**/*.module.css",
        "packages/review-ui/src/ThreadSheet/**/*.module.css"
      ],
      "rules": {
        "declaration-property-unit-disallowed-list": [
          {
            "/^(padding|margin|gap|row-gap|column-gap)(-.+)?$/": ["rem"]
          },
          {
            "severity": "warning",
            "message": "Pendiente de redondear a la escala de espaciado (docs/espaciado-fuera-de-escala.md). Al terminar la carpeta, quítala de «overrides» en .stylelintrc.json."
          }
        ]
      }
    }
  ]
}
