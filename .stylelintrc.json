{
  "rules": {
    "declaration-property-value-disallowed-list": [
      {
        "/(transition|transition-duration|transition-delay|transition-timing-function|animation|animation-duration|animation-delay|animation-timing-function|--[\\w-]*(duration|ease)[\\w-]*)/": [
          "/(?<![\\d.])(?!0m?s\\b)\\d*\\.?\\d+m?s\\b/",
          "/(?<![\\w-])(ease|ease-in|ease-out|ease-in-out|linear)(?![\\w-])/",
          "/cubic-bezier\\(/",
          "/steps\\(/"
        ]
      },
      {
        "message": "Valor quemado: la duración y la curva de una transición salen de variables (--duration-*, --ease*); ver apps/web/src/index.css. Un valor fuera de ellas se justifica con un comentario stylelint-disable-next-line."
      }
    ],
    "declaration-property-value-allowed-list": [
      {
        "/^(border|border-(top|bottom)-(left|right)|border-(start|end)-(start|end))-radius$/": [
          "/^(0|inherit|var\\(.+\\))$/"
        ],
        "font-family": ["/^(var\\(.+\\)|inherit)$/"],
        "font-size": ["/^(var\\(.+\\)|calc\\(.*var\\(.+\\).*\\)|inherit)$/"],
        "font-weight": ["/^(var\\(.+\\)|inherit)$/"],
        "font": [
          "/^(?!(\\d{3}|bold|bolder|lighter)\\s)(?!.*[\\s/][\\d.]+(px|rem|em|pt)\\b)(?!.*[\"']).*$/"
        ],
        "/^(border(-(top|right|bottom|left|block|inline)(-(start|end))?)?(-width)?|outline(-width)?)$/": [
          "/^(?!.*(^|[\\s(])-?[\\d.]+(px|rem|em)\\b).*$/"
        ],
        "line-height": ["/^(var\\(.+\\)|inherit|normal)$/"],
        "letter-spacing": ["/^(var\\(.+\\)|inherit|normal|0)$/"]
      },
      {
        "message": "Tipografía, bordes y radios salen de variables: --font-*, --leading-*, --tracking-*, --border-w*, --radius-* (apps/web/src/index.css). Un caso fuera de eso se justifica con un comentario stylelint-disable-next-line."
      }
    ],
    "color-no-hex": [
      true,
      {
        "message": "Un color no se escribe en un componente: usa una variable (--fg, --bg, --line, --danger…); un color nuevo se define en apps/web/src/index.css."
      }
    ],
    "color-named": [
      "never",
      {
        "message": "Un color no se escribe en un componente: usa una variable con nombre (ver apps/web/src/index.css)."
      }
    ],
    "function-disallowed-list": [
      [
        "rgb",
        "rgba",
        "hsl",
        "hsla",
        "hwb",
        "lab",
        "lch",
        "oklab",
        "oklch",
        "color-mix"
      ],
      {
        "message": "Un color no se escribe en un componente: usa una variable con nombre (--tint, --fill, --line, --danger…); una mezcla nueva se nombra en apps/web/src/index.css."
      }
    ],
    "declaration-property-unit-disallowed-list": [
      {
        "/^(padding|margin|gap|row-gap|column-gap)(-.+)?$/": ["rem"]
      },
      {
        "message": "El espaciado sale de la escala: var(--space-1…7) (apps/web/src/index.css). Un valor fuera de ella se justifica con un comentario stylelint-disable-next-line."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "apps/web/src/admin/AdminPage/**/*.module.css",
        "apps/web/src/home/HomePage/components/ChoiceGroup/**/*.module.css",
        "apps/web/src/document/DocumentPage/**/*.module.css",
        "apps/web/src/document/DocumentPage/components/DocumentSheet/**/*.module.css",
        "apps/web/src/document/DocumentsPage/**/*.module.css",
        "apps/web/src/document/components/**/*.module.css",
        "apps/web/src/document/editor/**/*.module.css",
        "apps/web/src/document/EditorPage/**/*.module.css",
        "apps/web/src/shared/ui/FieldGroup/**/*.module.css",
        "apps/web/src/shared/ui/FilePicker/**/*.module.css",
        "apps/web/src/document/DocumentPage/components/Hero/**/*.module.css",
        "apps/web/src/shared/ui/HowToReview/**/*.module.css",
        "apps/web/src/shared/ui/Loading/**/*.module.css",
        "apps/web/src/deck/components/NewDeckSheet/**/*.module.css",
        "apps/web/src/shared/ui/PageBar/**/*.module.css",
        "apps/web/src/document/DocumentPage/components/PeopleCards/**/*.module.css",
        "apps/web/src/document/prose/**/*.module.css",
        "apps/web/src/document/DocumentPage/components/ReviewNavigation/**/*.module.css",
        "apps/web/src/document/DocumentPage/components/ReviewSummary/**/*.module.css",
        "apps/web/src/document/DocumentPage/components/SectionView/**/*.module.css",
        "apps/web/src/document/DocumentPage/components/SideNav/**/*.module.css",
        "apps/web/src/shared/ui/Skeleton/**/*.module.css",
        "apps/web/src/document/DocumentPage/components/SourcesFooter/**/*.module.css",
        "apps/web/src/shared/ui/ThemeSwitch/**/*.module.css",
        "apps/web/src/document/DocumentPage/components/TopBar/**/*.module.css",
        "apps/web/src/shared/ui/UserMenu/**/*.module.css",
        "apps/web/src/document/DocumentPage/components/ReviewNavigation/components/VersionsSheet/**/*.module.css",
        "packages/review-ui/src/AccessPanel/**/*.module.css",
        "packages/review-ui/src/ActionMenu/**/*.module.css",
        "packages/review-ui/src/ApprovalsSheet/**/*.module.css",
        "packages/review-ui/src/BlockLayer/**/*.module.css",
        "packages/review-ui/src/BottomSheet/**/*.module.css",
        "packages/review-ui/src/Button/**/*.module.css",
        "packages/review-ui/src/MenuConfirm/**/*.module.css",
        "packages/review-ui/src/MenuItem/**/*.module.css",
        "packages/review-ui/src/PersonCard/**/*.module.css",
        "packages/review-ui/src/PinGate/**/*.module.css",
        "packages/review-ui/src/ThreadSheet/**/*.module.css"
      ],
      "rules": {
        "declaration-property-unit-disallowed-list": [
          {
            "/^(padding|margin|gap|row-gap|column-gap)(-.+)?$/": ["rem"]
          },
          {
            "severity": "warning",
            "message": "Pendiente de redondear a la escala de espaciado (docs/espaciado-fuera-de-escala.md). Al terminar la carpeta, quítala de «overrides» en .stylelintrc.json."
          }
        ]
      }
    }
  ]
}
