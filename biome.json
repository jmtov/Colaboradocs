{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!**/dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNestedTernary": "error",
        "noNonNullAssertion": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDuplicateProperties": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/home/**",
                      "@/admin/**",
                      "@/document/**",
                      "@/deck/**",
                      "@/task/**"
                    ],
                    "message": "Capas: app → home, admin → document, deck → task → shared. «shared» no importa hacia arriba ni de una feature hermana."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/task/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/home/**",
                      "@/admin/**",
                      "@/document/**",
                      "@/deck/**"
                    ],
                    "message": "Capas: app → home, admin → document, deck → task → shared. «task» no importa hacia arriba ni de una feature hermana."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/deck/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/home/**",
                      "@/admin/**",
                      "@/document/**"
                    ],
                    "message": "Capas: app → home, admin → document, deck → task → shared. «deck» no importa hacia arriba ni de una feature hermana."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/document/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/home/**",
                      "@/admin/**",
                      "@/deck/**"
                    ],
                    "message": "Capas: app → home, admin → document, deck → task → shared. «document» no importa hacia arriba ni de una feature hermana."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/home/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/admin/**"],
                    "message": "Capas: app → home, admin → document, deck → task → shared. «home» no importa hacia arriba ni de una feature hermana."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/admin/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/home/**"],
                    "message": "Capas: app → home, admin → document, deck → task → shared. «admin» no importa hacia arriba ni de una feature hermana."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/**/*.test.ts", "apps/web/src/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/review-core/src/review/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../access/**", "../document/**", "../task/**"],
                    "message": "review-core: «review» no importa de access, document, task. Lo compartido va en shared/; document, access y task se apoyan en review."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/review-core/src/access/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../document/**", "../task/**"],
                    "message": "review-core: «access» no importa de document, task. Lo compartido va en shared/; document, access y task se apoyan en review."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/review-core/src/document/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../access/**", "../task/**"],
                    "message": "review-core: «document» no importa de access, task. Lo compartido va en shared/; document, access y task se apoyan en review."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/review-core/src/task/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../access/**", "../document/**", "../review/**"],
                    "message": "review-core: «task» no importa de access, document, review. Lo compartido va en shared/; document, access y task se apoyan en review."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/review-core/src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../access/**",
                      "../document/**",
                      "../review/**",
                      "../task/**"
                    ],
                    "message": "review-core: «shared» no importa de access, document, review, task. Lo compartido va en shared/; document, access y task se apoyan en review."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/review-core/src/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "plugins": ["./.biome/no-inline-style.grit"]
}
